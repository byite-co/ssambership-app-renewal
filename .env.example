# 복사해서 .env 로 사용. 개발은 로컬 Supabase, 출시는 원격 production.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL_LAN=
SUPABASE_ANON_KEY=

# 출시(원격 production) 예시 — 값은 운영 콘솔에서 발급받아 채운다:
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<remote-anon-key>

# 크래시 리포팅(Sentry, G3). 비워두면 리포팅 비활성(개발·CI 기본).
SENTRY_DSN=
# 미지정 시 staging. 출시 빌드는 production 으로.
SENTRY_ENVIRONMENT=

# 본인인증 게이트 — 웹 IDENTITY_GATE_ENABLED 와 같은 값으로 맞춘다('true' 만 ON).
# ON 이면 미인증 학생은 구독 결제 대신 웹 본인인증으로 안내된다. DB 가드는 없다.
IDENTITY_GATE_ENABLED=
